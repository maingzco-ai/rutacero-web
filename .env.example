# RutaCero - Variables de Entorno
# Copia este archivo a .env.local y completa los valores

# ============================================
# EMAIL (Resend - recomendado)
# ============================================
# Consigue tu API key en https://resend.com/api-keys
# Plan gratis: 3.000 emails/mes
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email remitente verificado en Resend (Settings > Domains)
# Ejemplo: codigo@rutacero.co
EMAIL_FROM=RutaCero <codigo@rutacero.co>

# ============================================
# WHATSAPP BUSINESS API (Meta) - Opcional
# ============================================
# Configurar en https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=tu_token_secreto_para_webhook
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxx

# ============================================
# BASE DE DATOS (Supabase / PostgreSQL)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# REDIS (Upstash - para rate limiting producción)
# ============================================
# UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxx

# ============================================
# MAPS / ROUTING (Valhalla self-hosted)
# ============================================
# VALHALLA_URL=https://tu-valhalla.railway.app

# ============================================
# PAYMENTS (Stripe Connect)
# ============================================
# STRIPE_SECRET_KEY=sk_test_TU_CLAVE_AQUI
# STRIPE_PUBLISHABLE_KEY=pk_test_TU_CLAVE_AQUI
# STRIPE_WEBHOOK_SECRET=whsec_TU_CLAVE_AQUI

# ============================================
# ANALYTICS (PostHog)
# ============================================
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com