# ============================================
# RutaCero - Variables de Entorno de Configuración
# Copia este archivo a .env.local y completa con tus credenciales
# ============================================

# MODO DEMO / ENTORNO
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# TELEGRAM BOT & WEBHOOKS
# ============================================
# Token de acceso obtenido desde @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# Nombre de usuario de tu bot en Telegram (sin el @)
NEXT_PUBLIC_TELEGRAM_BOT=Rrutabot
# Token secreto opcional para verificar solicitudes del webhook de Telegram
TELEGRAM_WEBHOOK_SECRET=

# ============================================
# EMAIL TRANSACCIONAL (Resend)
# ============================================
# Consigue tu clave de API en https://resend.com/api-keys
# En modo desarrollo/demo sin clave, el código OTP se imprime en consola
RESEND_API_KEY=
# Dirección del remitente (Debe ser un dominio verificado en Resend o 'onboarding@resend.dev' para pruebas)
EMAIL_FROM=RutaCero <onboarding@resend.dev>

# ============================================
# REDIS (Upstash - Persistencia de estados y Rate Limiting)
# ============================================
# Si se deja vacío, la aplicación utiliza almacenamiento seguro en memoria (modo local/demo)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# SERVICIO DE RUTAS Y MAPAS (OSRM / Valhalla)
# ============================================
# Por defecto se utiliza el servicio público OSRM para Cali
# VALHALLA_URL=https://valhalla.ejemplo.co
